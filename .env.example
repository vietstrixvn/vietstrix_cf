# Google Business Profile API Configuration
# Follow setup guide: docs/GBP-AUTO-SYNC-SETUP.md

# GBP Account & Location IDs
# Get from: https://developers.google.com/my-business/reference/rest/v4/accounts/list
GBP_ACCOUNT_ID=accounts/YOUR_ACCOUNT_ID
GBP_LOCATION_ID=locations/YOUR_LOCATION_ID

# Authentication Method 1: Access Token (simple, expires in 1 hour)
GBP_ACCESS_TOKEN=ya29.YOUR_ACCESS_TOKEN

# Authentication Method 2: Service Account JSON (recommended for production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Site URL (for server-side API calls)
NEXT_PUBLIC_SITE_URL=https://www.vietstrix.com

# Optional: Cron job secret for triggering manual revalidation
CRON_SECRET=your-random-secret-here
